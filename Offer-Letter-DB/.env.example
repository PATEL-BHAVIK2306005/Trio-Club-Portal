# MongoDB Compass & Server Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aws_sbg_itmbu

# ==============================================================================
# NODEMAILER MULTI-ORGANIZATION GMAIL SMTP DISPATCH CONFIGURATION
# ==============================================================================
# To send real emails automatically from official club email IDs:
# 1. Go to your Google Account (e.g. for aws.itmbu@gmail.com) -> Security -> 2-Step Verification
# 2. At the bottom, click "App passwords" -> Create name: "Trio Club Portal"
# 3. Paste the generated 16-character code below:

# 1. AWS Student Builder Group Desk (aws.itmbu@gmail.com)
AWS_EMAIL_USER=aws.itmbu@gmail.com
AWS_EMAIL_PASS=your_16_digit_aws_app_password

# 2. Techno Lab Desk (technolabclub25@gmail.com)
TECHNO_EMAIL_USER=technolabclub25@gmail.com
TECHNO_EMAIL_PASS=your_16_digit_techno_app_password

# 3. GDGoC ITMBU Desk (gdgoc.itmbu@gmail.com)
GDGOC_EMAIL_USER=gdgoc.itmbu@gmail.com
GDGOC_EMAIL_PASS=your_16_digit_gdgoc_app_password

# Optional: Shared Master Fallback
# EMAIL_USER=aws.itmbu@gmail.com
# EMAIL_PASS=your_shared_16_digit_app_password
