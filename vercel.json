{
  "buildCommand": "cd offer-letter-genrator && npm install --legacy-peer-deps && CI=false npm run build",
  "outputDirectory": "offer-letter-genrator/build",
  "env": {
    "CI": "false"
  },
  "build": {
    "env": {
      "CI": "false"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

