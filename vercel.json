{
  "version": 2,
  "buildCommand": "cd offer-letter-genrator && npm install && npm run build",
  "outputDirectory": "offer-letter-genrator/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
